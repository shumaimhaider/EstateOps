# Shared by every service. Copy to .env (never commit it).
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://estateops:estateops@localhost:5432/estateops
# Optional read replica for list and stats endpoints
READ_DATABASE_URL=
# RS256 keys as PEM (identity needs both, the others only the public key)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Shared secret for /internal/* endpoints and event delivery
INTERNAL_TOKEN=change-me
# Where each service listens, and where the relay delivers events (comma separated base URLs)
EVENT_SUBSCRIBERS=http://localhost:8101,http://localhost:8102,http://localhost:8103,http://localhost:8104,http://localhost:8105,http://localhost:8106
# identity only
BOOTSTRAP_TOKEN=change-me-too
# contract only
STORAGE_DIR=./storage
# gateway upstreams
UPSTREAM_IDENTITY=http://localhost:8101
UPSTREAM_INVENTORY=http://localhost:8102
UPSTREAM_CUSTOMER=http://localhost:8103
UPSTREAM_SALES=http://localhost:8104
UPSTREAM_BILLING=http://localhost:8105
UPSTREAM_CONTRACT=http://localhost:8106
