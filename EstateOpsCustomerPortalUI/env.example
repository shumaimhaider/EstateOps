# Copy to .env.local. The portal always talks to the real API: through the gateway (dev proxy in
# vite.config.js, GATEWAY_URL), or through nginx in Docker.
VITE_API_BASE_URL=/api/v1
# Which developer this portal serves (hides the Developer field), e.g. pk. Blank: customers type it.
VITE_TENANT_SLUG=
# Card payments: Stripe's own form (the API sends the publishable key with every checkout).
# stand_in shows our own card form for a stand-in Stripe server (tests, demos).
VITE_STRIPE_UI=auto
VITE_STRIPE_API_URL=/stripe/v1
