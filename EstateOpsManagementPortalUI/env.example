# Copy to .env.local. The portal always talks to the real API: through the gateway (see vite.config.js
# for the dev proxy, GATEWAY_URL), or through nginx in Docker.
VITE_API_BASE_URL=/api/v1
# rest | graphql: the back end serves REST only
VITE_API_TRANSPORT=rest
VITE_GRAPHQL_URL=/graphql
VITE_GOOGLE_CLIENT_ID=
# Card payments: Stripe's own form (the API sends the publishable key with every checkout).
# stand_in shows our own card form for a stand-in Stripe server (tests, demos): see Backend mock-providers.
VITE_STRIPE_UI=auto
VITE_STRIPE_API_URL=/stripe/v1
