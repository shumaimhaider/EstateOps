# Copy to .env.local. mock = MSW serves the API in the browser; real = calls the URLs below.
VITE_API_MODE=mock
# rest | graphql (global default; override per feature in src/shared/config/transport.config.js)
VITE_API_TRANSPORT=rest
VITE_API_BASE_URL=/api/v1
VITE_GRAPHQL_URL=/graphql
# Card payments (Stripe). Mock mode ignores these; real mode needs the publishable key.
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_API_URL=/stripe/v1
