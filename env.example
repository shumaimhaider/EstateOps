# =============================================================================================
# EstateOps configuration. This is the ONE file you edit to run the whole system.
#
#   make init          creates .env from this file and generates the secrets that can be generated
#                      (database password, signing keys, internal tokens). It never overwrites a
#                      value you have already set.
#   make init-mock     the same, but also fills the card, e-signature and file-storage settings with
#                      the built-in stand-ins, so everything works with no outside accounts.
#   then               make up
#
# .env holds secrets: it is ignored by git. Never commit it.
# =============================================================================================

# ---- generated by `make init` (leave blank) ------------------------------------------------
POSTGRES_PASSWORD=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
INTERNAL_TOKEN=
BOOTSTRAP_TOKEN=

# ---- email (customer notices, invitations, password resets) -------------------------------
# An SMTP address: smtp://user:password@smtp.example.com:587  (smtps:// for implicit TLS).
# Leave blank to print emails in the identity/billing/customer logs instead of sending them.
SMTP_URL=
MAIL_FROM=EstateOps <no-reply@yourdomain.com>
# Where customers' support requests are announced by email (the staff queue always has them).
SUPPORT_EMAIL=

# ---- card payments: Stripe ------------------------------------------------------------------
# Dashboard -> Developers -> API keys, and Webhooks (endpoint: https://YOUR-HOST/webhooks/stripe,
# events: payment_intent.*, setup_intent.*, checkout.session.*, charge.refunded).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Only for the built-in stand-in (`make init-mock` sets it). Leave blank for real Stripe.
STRIPE_API_BASE=

# ---- e-signature: PandaDoc ---------------------------------------------------------------
# API key, the shared key of the webhook (endpoint: https://YOUR-HOST/webhooks/pandadoc, event
# document_state_changed) and the ids of your two templates.
PANDADOC_API_KEY=
PANDADOC_WEBHOOK_KEY=
PANDADOC_TEMPLATE_SALE_AGREEMENT=
PANDADOC_TEMPLATE_PAYMENT_PLAN=
# Only for the stand-in. Leave the defaults for real PandaDoc.
PANDADOC_API_BASE=https://api.pandadoc.com
PANDADOC_SESSION_BASE=https://app.pandadoc.com/s

# ---- file storage (unit pictures, site maps): any S3-compatible bucket -------------------------
# STORAGE_PUBLIC_BASE_URL is the only place that decides where files are served from. To move to
# another provider, copy the objects and change this (and the S3_* values). Stored paths stay.
STORAGE_DRIVER=s3
S3_BUCKET=estateops
S3_REGION=us-east-1
# Blank for AWS S3; a URL for MinIO / R2 / the stand-in.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://estateops.s3.us-east-1.amazonaws.com

# ---- messaging and cache ------------------------------------------------------------------
# http: services call each other directly (simple). kafka: use the broker in docker-compose
# (start it with `make up-kafka`).
EVENT_TRANSPORT=http
KAFKA_BROKERS=kafka:9092
# Shared cache and rate limits. The compose file starts Redis for you.
REDIS_URL=redis://redis:6379

# ---- the daily automatic collection ------------------------------------------------------
# "HH:MM" UTC. COLLECTION_ENABLED=false turns automatic charging off.
COLLECTION_RUN_AT=06:00
COLLECTION_ENABLED=true

# ---- addresses --------------------------------------------------------------------------
# What people type in the browser. Used in emailed links and Stripe's return page.
MANAGEMENT_PORTAL_URL=http://localhost:5173
CUSTOMER_PORTAL_URL=http://localhost:5174
MANAGEMENT_PORTAL_PORT=5173
CUSTOMER_PORTAL_PORT=5174
GATEWAY_PORT=8080
# Allowed browser origins for direct API calls (comma separated). The portals use their own proxy.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
